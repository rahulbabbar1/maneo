<?xml version="1.0" encoding="UTF-8"?>
<CHARConfig>
	<!--logging level range from 0 - 8. 1=SEVERE, 8=All, 0=OFF-->
	<logginglevel>8</logginglevel>
	<logfile>logs\\logs.txt</logfile>
	<Identity>
		<ServiceMessageType>HMRC-CHAR-CLM,HMRC-CHAR-CLM-MULTI</ServiceMessageType>
		<EnvelopeNamespace>http://www.govtalk.gov.uk/CM/envelope</EnvelopeNamespace>
	</Identity>
	<Handlers>
		<Handler ExitOnError="false">uk.gov.hmrc.aspire.lts.requesthandlers.MetaDataHandler</Handler>
		<Handler ExitOnError="true">uk.gov.hmrc.aspire.lts.requesthandlers.DecompressionHandler</Handler>
		<Handler ExitOnError="true">uk.gov.hmrc.aspire.lts.requesthandlers.ValidationHandler</Handler>
		<Handler ExitOnError="true">uk.gov.hmrc.aspire.lts.requesthandlers.CharityDownloadHandler</Handler>
		<Handler ExitOnError="false">uk.gov.hmrc.aspire.lts.requesthandlers.IRMarkHandler</Handler>
	</Handlers>
	<!-- Configuration used by the MetaDataHandler -->
	<Data>
		<MetaData key="MessageClass">/GovTalkMessage/Header/MessageDetails/Class</MetaData>
		<MetaData key="IR_HMRC_Mark">/GovTalkMessage/Body/IRenvelope/IRheader/IRmark</MetaData>
		<MetaData key="SystemTimestamp">/GovTalkMessage/Header/MessageDetails/GatewayTimestamp</MetaData>
		<MetaData key="ClaimNo">/GovTalkMessage/Body/IRenvelope/R68/AgtOrNom/ClaimNo</MetaData>
		<MetaData key="Credential">/GovTalkMessage/GovTalkDetails/Keys/Key</MetaData>
	</Data>
	<!-- Configuration used by the DecompressionHandler -->
	<Decompression>
		<!-- Full XPath pointing to the element containing the compressed data -->
		<CompressedPartXPath>/GovTalkMessage/Body/IRenvelope/R68/CompressedPart</CompressedPartXPath>
		<!-- Name of the attribute, on the 'compressed part' element, which defines the type of compression that was used to compress the data -->
		<CompressionTypeAttributeName>Type</CompressionTypeAttributeName>
		<!-- Used to indicate if check to be done on decompressed submission size -->
		<CompressionSizeCheckInd>on</CompressionSizeCheckInd>
		<CompressionSizeLimit>104857600</CompressionSizeLimit>
	</Decompression>
</CHARConfig>