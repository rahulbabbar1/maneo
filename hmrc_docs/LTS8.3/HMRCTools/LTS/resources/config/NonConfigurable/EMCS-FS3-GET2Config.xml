		<MetaData key="ExciseRegNumber">/tns:Envelope/tns:Body/gmm:GetAllEventMessagesForMovement/gmm:ExciseRegistrationNumber</MetaData>
		<MetaData key="ARC">/tns:Envelope/tns:Body/gmm:GetAllEventMessagesForMovement/gmm:ARC</MetaData>
		<MetaData key="Username">/tns:Envelope/tns:Header/wsse:Security/wsse:UsernameToken/wsse:Username</MetaData>
	</Data>
</GET2Config>