        </xsd:simpleType>
      </xsd:element>
    </xsd:sequence>
    <xsd:attribute use="optional" name="Type" type="rim:RIMDemo_WorkHomeType"/>
    <xsd:attribute use="optional" name="Mobile" type="rim:RIMDemo_YesNoType"/>
    <xsd:attribute use="optional" name="Preferred" type="rim:RIMDemo_YesNoType"/>
  </xsd:complexType>
  <xsd:simpleType name="RIMDemo_WorkHomeType">
